import matplotlib.pyplot as plt
import numpy as np
years = ['2015', '2016', '2017', '2018', '2019']
IT = [12, 30, 16, 8, 23]
ECE = [28, 6, 5, 3, 10]
CSE = [29, 2, 24, 25, 17]
x = np.arange(len(years))
width = 0.25
plt.figure(figsize=(10,5))
plt.bar(x - width, IT, width, label='IT')
plt.bar(x, ECE, width, label='ECE')
plt.bar(x + width, CSE, width, label='CSE')
plt.xlabel("Year")
plt.ylabel("Students Passed")
plt.title("Students Passed in Different Branches")
plt.xticks(x, years)
plt.legend()
plt.show()
